demo/fake_feed.py
# python bytecode
__pycache__/
*.pyc

# GPU demo state — which pod this checkout rented (gpu_demo_up.sh)
/.gpu_demo_state
# macOS Finder metadata
.DS_Store
/tests/segments_test
/libmemchal_weights.so
# local secrets, such as RUNPOD_API_KEY — never committed
.env
/.gpu_weights_state
